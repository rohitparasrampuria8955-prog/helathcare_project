{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "rohitbigdata3"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"helthcare_project_link_service_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'helthcare_project_link_service'"
		},
		"projectlinkservice_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'projectlinkservice'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://databricksdatastore123.dfs.core.windows.net/"
		},
		"helthcare_project_link_service_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcareprojectstorage.dfs.core.windows.net/"
		},
		"projectlinkservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://rohitprojectdata.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "rohitbigdata3_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"helthcare_project_link_service_accountKey": {
						"value": "[parameters('helthcare_project_link_service_accountKey')]"
					},
					"projectlinkservice_accountKey": {
						"value": "[parameters('projectlinkservice_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"helthcare_project_link_service_properties_typeProperties_url": {
						"value": "[parameters('helthcare_project_link_service_properties_typeProperties_url')]"
					},
					"projectlinkservice_properties_typeProperties_url": {
						"value": "[parameters('projectlinkservice_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}